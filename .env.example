# ==============================================================================
# CivicsPulse — Zero-Budget Smart Campus MVP Environment Configuration
# ₹0 Total Budget Architecture (Local Fallback + Supabase Free Tier)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE FREE TIER CONFIGURATION (OPTIONAL - ZERO COST)
# ------------------------------------------------------------------------------
# CivicsPulse includes a 100% zero-configuration local persistence engine out-of-the-box.
# If you leave these values blank or unset, the application automatically runs on the
# local atomic storage engine with persistence in `.civicspulse-data.json`.
#
# To connect to your genuinely free Supabase project:
# 1. Create a free account at https://supabase.com (No credit card required).
# 2. Create a new project (e.g. "civicspulse-dev").
# 3. In the Supabase SQL Editor, run:
#    - `supabase/migrations/001_initial_schema.sql`
#    - `supabase/migrations/002_rls_and_atomic_functions.sql`
# 4. Copy your Project URL and Anon/Public Key from Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. ZERO-COST LOCAL AI CONFIGURATION
# ------------------------------------------------------------------------------
# CivicsPulse uses pure TypeScript TF-IDF, Jaccard Tokenization, and explainable
# rule scoring for duplicate detection and priority classification.
# NO paid OpenAI, Anthropic, or external API keys are required!
NEXT_PUBLIC_AI_MODE=local_pure_typescript
