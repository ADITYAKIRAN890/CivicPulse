# ==============================================================================
# Civic Pulse — Zero-Budget Smart Campus MVP Environment Configuration
# ₹0 Total Budget Architecture (Local Fallback + Supabase Free Tier)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE FREE TIER CONFIGURATION (OPTIONAL - ZERO COST)
# ------------------------------------------------------------------------------
# Civic Pulse includes a 100% zero-configuration local persistence engine out-of-the-box.
# If you leave these values blank or unset, the application automatically runs on the
# local atomic storage engine with persistence in `.civicspulse-data.json`.
#
# To connect to your genuinely free Supabase project:
# 1. Create a free account at https://supabase.com (No credit card required).
# 2. Create a new project (e.g. "civicspulse-dev").
# 3. In the Supabase SQL Editor, run:
#    - `supabase/migrations/001_initial_schema.sql`
#    - `supabase/migrations/002_rls_and_atomic_functions.sql`
# 4. Copy your Project URL and Anon/Public Key from Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. ZERO-COST LOCAL AI CONFIGURATION
# ------------------------------------------------------------------------------
# Civic Pulse uses pure TypeScript TF-IDF, Jaccard Tokenization, and explainable
# rule scoring for duplicate detection and priority classification.
NEXT_PUBLIC_AI_MODE=local_pure_typescript

# ------------------------------------------------------------------------------
# 4. RESEND EMAIL NOTIFICATIONS CONFIGURATION
# ------------------------------------------------------------------------------
# Automated real-time email dispatch whenever a student submits an infrastructure complaint.
#
# RESEND_API_KEY: Your private server-side API key from https://resend.com/api-keys
# Starts with `re_...`. NEVER prefix with NEXT_PUBLIC_ or expose to the browser!
RESEND_API_KEY=re_your_resend_api_key_here

# COMPLAINT_NOTIFICATION_EMAIL: Dedicated inbox where complaint dispatch alerts will be delivered.
# INITIAL SETUP NOTICE: On Resend's free tier without a custom verified domain, Resend ONLY permits
# sending emails to your own registered/verified Resend account email address (e.g. your personal Gmail).
COMPLAINT_NOTIFICATION_EMAIL=your-verified-email@gmail.com

# EMAIL_FROM: The verified sender email address.
# Default testing address provided by Resend: `CivicsPulse Campus <onboarding@resend.dev>`
# Once you verify a custom institutional domain in Resend, change this to e.g. `alerts@yourcampus.edu`
EMAIL_FROM=CivicsPulse Campus <onboarding@resend.dev>

